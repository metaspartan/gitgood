# Copy to .env and adjust. docker compose reads this file automatically.

# Port published on the host.
GITGOOD_PORT=3000

# Public URL clients will use. Change this when deploying behind TLS or a proxy.
GITGOOD_BASE_URL=http://localhost:3000

# Set to "false" after creating the first account to close public registration.
# The first account created is always the instance administrator.
GITGOOD_ALLOW_SIGNUP=true

# Concurrent git subprocesses. 16 suits a 2-4 core box; raise on bigger hosts.
# Watch git_queue_depth in /api/metrics: if it is not zero under normal load,
# this is too low. Each git process can transiently use tens of MiB while packing.
GITGOOD_GIT_CONCURRENCY=16

# debug | info | warn | error
GITGOOD_LOG_LEVEL=info

# Trust X-Forwarded-* headers. Only enable behind a proxy you control: with it
# on and no proxy in front, a client can spoof its own IP and bypass rate limits.
# Also gates whether HSTS is sent, since that depends on knowing the request
# arrived over TLS.
GITGOOD_TRUST_PROXY=false

# Where state lives. Back this up; see DEPLOYMENT.md.
GITGOOD_DATA_DIR=./data

# Largest accepted LFS object, in bytes. Default 5 GiB.
GITGOOD_MAX_LFS_BYTES=5368709120

# Default storage ceiling per repository, in bytes. Default 2 GiB.
# A single repository can override this through PUT /api/repos/:owner/:name/quota
# (0 there means unlimited). A push that would exceed the ceiling is refused with
# 413 before the pack is written, so the bytes never land.
GITGOOD_MAX_REPO_BYTES=0

# Close repository creation instance-wide without turning off signups.
GITGOOD_ALLOW_REPO_CREATION=true

# Code search index budget, per repository. The indexer reads blobs out of git,
# so these are what stop a vendored dependency tree from being read in full.
GITGOOD_CODE_INDEX_MAX_FILES=2000
GITGOOD_CODE_INDEX_MAX_FILE_BYTES=262144
GITGOOD_CODE_INDEX_MAX_TOTAL_BYTES=33554432

# SSH. GitGood does not speak the SSH protocol; tools/ssh-command.ts is the forced
# command a system sshd runs. Leave GITGOOD_SSH_COMMAND empty to have the
# generator write an absolute path to this deployment's own script.
# See DEPLOYMENT.md section 7 for the sshd configuration.
GITGOOD_SSH_COMMAND=
GITGOOD_SSH_PORT=22

# Push policy defaults for new repositories. These map onto git's own receive-side
# settings, so enforcement happens inside receive-pack rather than after it. A
# single repository can override any of them (see DEPLOYMENT.md section 6).
#
# Refuse pushes that rewrite existing history. Off by default, because rewriting
# your own branch is a normal thing to do.
GITGOOD_DENY_NON_FAST_FORWARDS=false
# Refuse pushes that delete a ref.
GITGOOD_DENY_DELETES=false
# Validate each received object's hash and connectivity as it arrives, rather than
# discovering the corruption when someone tries to read it. On by default.
GITGOOD_FSCK_OBJECTS=true

# Webhook SSRF guard. Destinations on loopback, link-local (cloud metadata)
# and private ranges are refused by default. Set to 1 only if this instance
# must deliver webhooks to internal services (e.g. CI on a private VLAN).
#GITGOOD_WEBHOOK_ALLOW_PRIVATE=0

GITGOOD_CI_MODE=runner

#GITGOOD_AUTH_RATE_MAX=30

# Optional: Google Drive backups. Usually set in Admin -> Backups instead.
# GITGOOD_GOOGLE_CLIENT_ID=
# GITGOOD_GOOGLE_CLIENT_SECRET=
# Optional: key for encrypting stored credentials (defaults to <data dir>/secret.key)
# GITGOOD_SECRET_KEY=
