# Normalise text files to LF in the repository so the code reads identically on
# every platform and patch scripts can rely on \n.
* text=auto eol=lf

# Windows-only helpers keep their native line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.woff2 binary
*.ico binary

# Vendored bundles should not skew language statistics.
bun.lock linguist-generated=true
bench/results/*.json linguist-generated=true